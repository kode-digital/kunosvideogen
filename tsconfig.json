{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["capture", "generate", "knowledge"],
  "exclude": ["node_modules", "out", "library", "dist"]
}
